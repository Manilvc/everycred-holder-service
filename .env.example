# Copy to .env for local development. Never commit real values.

SERVICE_NAME=everycred-holder-service
# One of: local, development, staging, production
ENVIRONMENT=local

LOG_LEVEL=INFO
# Use true in deployed environments.
LOG_JSON=false

# API docs are always disabled in production regardless of this flag.
ENABLE_DOCS=true
# JSON list of web origins, e.g. ["https://wallet.example.com"]. The native
# wallet app sends no Origin header and needs no entry.
CORS_ALLOWED_ORIGINS=[]

# MySQL / MariaDB through the aiomysql driver. A database of its own, not
# the DCS database. For the host's MySQL socket in Docker, see
# docker-compose.mysql-socket.yml.
DATABASE_URL=mysql+aiomysql://<user>:<password>@127.0.0.1:3306/everycred_holder?charset=utf8mb4
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE_SECONDS=1800

HTTP_TIMEOUT_SECONDS=10
HTTP_MAX_CONNECTIONS=100

# At least 32 characters each. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<random-secret>
TOKEN_HASH_SECRET=<random-secret>
SESSION_LIFETIME_DAYS=30
REGISTRATION_TOKEN_MINUTES=15

OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_TTL_MINUTES=30
# {token} is replaced with the reset token.
PASSWORD_RESET_URL=everycredwallet://reset-password?token={token}

# EveryCRED connector. The API key is issued by the connector for a client
# of kind holder_service. The webhook secret must equal the connector's
# HOLDER_SERVICE_WEBHOOK_SECRET (at least 32 characters).
CONNECTOR_BASE_URL=http://127.0.0.1:8050
CONNECTOR_API_KEY=<connector-api-key>
CONNECTOR_WEBHOOK_SECRET=<random-secret>
CONNECTOR_TIMEOUT_SECONDS=15
WEBHOOK_TOLERANCE_SECONDS=300

DID_PREFIX=did:evrc:holder
MAX_KEYS_PER_HOLDER=10

# Holder files: "local" (development; served at /media) or "s3" (required
# in production; private bucket, presigned URLs). AWS credentials come from
# the standard chain (IAM role, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=media
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8040/media
STORAGE_URL_TTL_SECONDS=900
AWS_REGION=
S3_BUCKET=
S3_PREFIX=holder-service
MAX_PROFILE_IMAGE_BYTES=2097152
MAX_PRESENTATION_BYTES=1048576

# Email: "console" (development; nothing is sent) or "smtp" (required in
# production).
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
CREDENTIAL_EMAIL_HOURLY_LIMIT=10

# Live notifications. Leave SOCKET_REDIS_URL empty to turn socket events
# off; it must point at the Redis database the EveryCRED Socket service
# subscribes to (DB 2 by default), e.g. redis://:<password>@redis:6379/2
SOCKET_REDIS_URL=
SOCKET_CHANNEL=socketio_notifications
SOCKET_EVENT=new_request
# Push via FCM HTTP v1. Set both or neither; the JSON is the Firebase
# service account key on one line.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=
NOTIFICATION_REDIRECT_BASE_URL=everycredwallet://
NOTIFICATION_MAX_ATTEMPTS=8
WORKER_INTERVAL_SECONDS=5
